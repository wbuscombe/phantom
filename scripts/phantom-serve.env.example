# Phantom serve environment configuration
# Copy this file to /etc/phantom/phantom-serve.env and fill in values.

# Required: GitHub webhook secret for signature validation
PHANTOM_WEBHOOK_SECRET=your-webhook-secret-here

# Required: Mapping of repository names to manifest file paths
# Format: repo1=/path/to/manifest1.yml,repo2=/path/to/manifest2.yml
PHANTOM_MANIFEST_MAP=my-project=/home/phantom/projects/my-project/.phantom.yml
