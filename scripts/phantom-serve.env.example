# Phantom serve environment configuration
# Copy to /etc/phantom/phantom-serve.env and fill in values.
# Permissions should be 640 root:phantom.

# ── Required ──────────────────────────────────────────

# HMAC secret for GitHub webhook signature validation (X-Hub-Signature-256).
# Must match the secret configured in your GitHub webhook settings.
# Generate with: openssl rand -hex 32
PHANTOM_WEBHOOK_SECRET=

# Mapping of repository names to manifest file paths.
# Format: repo1=/path/to/manifest1.yml,repo2=/path/to/manifest2.yml
# The repo name is the repository name (not the full owner/repo).
PHANTOM_MANIFEST_MAP=

# ── Optional ──────────────────────────────────────────

# GitHub personal access token for cloning private repositories.
# Required only if your projects are in private repos.
# GITHUB_TOKEN=

# Anthropic API key for AI Director features.
# Required only if using director-assisted captures.
# ANTHROPIC_API_KEY=

# Virtual display number (must match Xvfb service).
# Default: :99
# DISPLAY=:99
